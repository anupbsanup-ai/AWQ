# Chicago Dental 312 AI Receptionist Environment Variables

# API Configuration
SECRET_KEY=your-secret-key-change-in-production
DEBUG=False

# Twilio Configuration (Required for voice calls)
TWILIO_ACCOUNT_SID=your-twilio-account-sid
TWILIO_AUTH_TOKEN=your-twilio-auth-token
TWILIO_PHONE_NUMBER=+1234567890

# Google Calendar Configuration
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_CALENDAR_ID=primary

# SendGrid Configuration (for email notifications)
SENDGRID_API_KEY=your-sendgrid-api-key

# Database
DATABASE_URL=sqlite:///./dental_receptionist.db

# Redis (optional, for session storage)
REDIS_URL=redis://localhost:6379/0

# Clinic Information
CLINIC_NAME=Chicago Dental 312
CLINIC_PHONE=(312) 555-0123
CLINIC_EMAIL=appointments@chicagodental312.com
CLINIC_ADDRESS=123 Dental Ave, Chicago, IL 60601
